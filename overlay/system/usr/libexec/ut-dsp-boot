#!/bin/sh
# Boot the Qualcomm DSPs (ADSP, CDSP, CVP) exactly like the stock vendor
# init.qti.kernel.rc does at early-boot. Stock fires these asynchronously
# BEFORE the HALs and audio machine driver initialize, so this unit runs
# before lxc-android-config: the audio card registration (machine_dlkm)
# then finds the ADSP services like on stock. Writing 1 is idempotent.
# adsp_loader_dlkm/cdsp_loader autoload host-side via DT modalias coldplug,
# which creates /sys/kernel/boot_adsp and /sys/kernel/boot_cdsp.
c=0
while [ ! -w /sys/kernel/boot_adsp/boot ] && [ $c -lt 90 ]; do sleep 1; c=$((c+1)); done
[ -w /sys/kernel/boot_adsp/boot ] && echo 1 > /sys/kernel/boot_adsp/boot && echo "ut-dsp-boot: boot_adsp written"
c=0
while [ ! -w /sys/kernel/boot_cdsp/boot ] && [ $c -lt 20 ]; do sleep 1; c=$((c+1)); done
[ -w /sys/kernel/boot_cdsp/boot ] && echo 1 > /sys/kernel/boot_cdsp/boot && echo "ut-dsp-boot: boot_cdsp written"
[ -w /sys/devices/virtual/cvp/cvp/boot ] && echo 1 > /sys/devices/virtual/cvp/cvp/boot && echo "ut-dsp-boot: cvp boot written"

# In the background: once the ADSP is actually running, rebind the SPF audio
# core if it gave up while the ADSP was still booting ("apm is not up") —
# without its child devices the machine driver never registers the sound
# card. Rebinding reruns the probe with the APM now reachable.
(
    c=0
    adsp_state() {
        for r in /sys/class/remoteproc/remoteproc*; do
            case "$(cat "$r"/name 2>/dev/null)" in *adsp*) cat "$r"/state 2>/dev/null; return;; esac
        done
    }
    while [ "$(adsp_state)" != "running" ] && [ $c -lt 90 ]; do sleep 2; c=$((c+1)); done
    for r in /sys/class/remoteproc/remoteproc*; do
        echo "ut-dsp-boot: $(cat "$r"/name 2>/dev/null) = $(cat "$r"/state 2>/dev/null)"
    done
    [ "$(adsp_state)" = "running" ] || exit 0
    sleep 5
    if ! grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null; then
        drv=/sys/bus/platform/drivers/spf_core_platform
        [ -d "$drv" ] || drv=/sys/bus/platform/drivers/spf-core-platform
        if [ -d "$drv" ] && [ -e "$drv/soc:spf_core_platform" ]; then
            echo "ut-dsp-boot: no sound card, rebinding spf core"
            echo soc:spf_core_platform > "$drv"/unbind 2>/dev/null
            sleep 2
            echo soc:spf_core_platform > "$drv"/bind 2>/dev/null
            sleep 10
            echo "ut-dsp-boot: cards after rebind: $(grep -c '^ *[0-9]' /proc/asound/cards 2>/dev/null)"
        else
            echo "ut-dsp-boot: spf core driver dir not found"
        fi
    else
        echo "ut-dsp-boot: sound card already present"
    fi
) &
exit 0
