#!/bin/sh
# Prepare a reproducible SSH endpoint for Wi-Fi-only development.
#
# No key ships with this image. To use it, place your own public key at
# /usr/share/gts9uwifi/authorized_keys before building, or append it to
# /home/phablet/.ssh/authorized_keys on the running device. Without a key
# this hook only creates the sshd runtime directories and host keys.
#
# ut-ssh-enable.service is not enabled by default; the flashable package
# also removes any leftover copy from userdata on install.
set -e

ssh-keygen -A >/dev/null 2>&1
install -d -m 0755 /run/sshd
install -d -o 32011 -g 32011 -m 0700 /home/phablet/.ssh

KEY=/usr/share/gts9uwifi/authorized_keys
AUTH=/home/phablet/.ssh/authorized_keys

[ -s "$KEY" ] || exit 0

touch "$AUTH"
grep -qxF "$(cat "$KEY")" "$AUTH" 2>/dev/null || cat "$KEY" >> "$AUTH"
chown 32011:32011 "$AUTH"
chmod 0600 "$AUTH"
