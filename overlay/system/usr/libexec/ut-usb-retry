#!/bin/sh
# usb-moded's first mtp activation races boot (its UDC bind lands before the
# appsync-started umtprd holds the functionfs ep0 -> ENODEV -> silent
# charging_only fallback, 18d1:0afe, a dead mass-storage stub on the host).
# Later requests can be dropped with "requested while busy". Once boot has
# settled, walk the useful modes until one binds.
g=/sys/kernel/config/usb_gadget/g1

bound_ok() {
    udc=$(cat "$g"/UDC 2>/dev/null)
    pid=$(cat "$g"/idProduct 2>/dev/null)
    echo "ut-usb-retry: UDC='$udc' idProduct='$pid'"
    [ -n "$udc" ] && [ "$pid" != "0x0afe" ] && [ "$pid" != "0x0AFE" ]
}

sleep 20

if bound_ok; then
    echo "ut-usb-retry: gadget already healthy"
else
    for mode in mtp_adb developer_mode mtp; do
        echo "ut-usb-retry: trying mode $mode"
        echo "" > "$g"/UDC 2>/dev/null
        if command -v usb_moded_util >/dev/null 2>&1; then
            usb_moded_util -s "$mode" 2>&1 | head -2
        else
            gdbus call --system --dest com.meego.usb_moded \
                --object-path /com/meego/usb_moded \
                --method com.meego.usb_moded.set_mode "$mode" 2>&1 | head -2
        fi
        sleep 8
        if bound_ok; then
            echo "ut-usb-retry: mode $mode bound"
            break
        fi
    done
fi

# WLAN: Samsung's qcacld defers hdd init until the framework WifiHAL writes
# the boot_wlan trigger; UT has no Android framework, so mirror the write
# here (harmless if the node is absent or the driver already initialized).
if [ -w /sys/kernel/boot_wlan/boot_wlan ]; then
    echo 1 > /sys/kernel/boot_wlan/boot_wlan
    echo "ut-usb-retry: boot_wlan trigger written"
    sleep 6
    ip link show wlan0 >/dev/null 2>&1 && echo "ut-usb-retry: wlan0 present" || echo "ut-usb-retry: wlan0 still absent"
else
    echo "ut-usb-retry: no /sys/kernel/boot_wlan node"
fi
exit 0
