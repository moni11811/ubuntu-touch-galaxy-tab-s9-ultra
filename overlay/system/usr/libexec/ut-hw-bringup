#!/bin/sh
# Consolidated gts9uwifi hardware bring-up: DSPs, PD-mapper, WLAN, audio, sensors.
# Log: /home/phablet/ut-hw-bringup.log
#
# Root cause solved (validated live 2026-07-16): the audio APM and the sensor
# SSC run in protection domains on the ADSP. The kernel GPR/SPF and the sensor
# HAL only learn a PD is up via service-registry notifications from
# /vendor/bin/pd-mapper. pd-mapper is a container "class core" service that
# starts at container init, BEFORE this script can boot the ADSP (the ADSP
# needs firmware_mnt, only mounted by the container). So pd-mapper finds no
# DSP and dies; audio_pd/sensor_pd never register and audio ("apm is not up")
# and sensors stay dead. Fix: after the ADSP is up, (re)start pd-mapper and
# keep it alive, then trigger an ADSP subsystem-restart (SSR) so the audio_pd
# / sensor_pd images reload WITH pd-mapper present -> "apm is up" and the
# kalama sound card registers; sensor_pd comes up for the sensor HAL.
LOG=/home/phablet/ut-hw-bringup.log
exec >>"$LOG" 2>&1
echo "===== ut-hw-bringup $(date) ====="
echo "integrated image script: apps + pd-mapper + DSP + WLAN + audio + sensors"

lxc() { lxc-attach -n android -- "$@"; }
adsp_state() {
    for r in /sys/class/remoteproc/remoteproc*; do
        case "$(cat "$r"/name 2>/dev/null)" in *adsp*) cat "$r"/state 2>/dev/null; return;; esac
    done
}
have_card() { grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null; }
android_pid() { lxc pidof "$1" 2>/dev/null | awk '{print $1}'; }

# --- 0. Repair the per-user application registry. On the current image,
# ~/.local can be created as root and the preinstalled Click hooks are not run
# for phablet. Morph then cannot create its profile, while Lomiri lists Click
# apps but rejects their AppIDs because ~/.cache/lomiri-app-launch/desktop is
# empty. Make the XDG data path writable and rebuild the link farm once. This
# also exposes the already preinstalled Terminal app in Lomiri's launcher.
if [ -d /home/phablet ]; then
    install -d -o 32011 -g 32011 -m 0700 /home/phablet/.local /home/phablet/.local/share
    chown 32011:32011 /home/phablet/.local /home/phablet/.local/share 2>/dev/null
    if ! find /home/phablet/.cache/lomiri-app-launch/desktop -maxdepth 1 \
        -name 'filemanager.ubports_filemanager_*.desktop' -print -quit 2>/dev/null | grep -q . || \
       ! find /home/phablet/.cache/lomiri-app-launch/desktop -maxdepth 1 \
        -name 'terminal.ubports_terminal_*.desktop' -print -quit 2>/dev/null | grep -q .; then
        click hook run-user --user=phablet 2>&1 || true
    fi
    echo "user apps: local=$(stat -c '%U:%G %a' /home/phablet/.local 2>/dev/null) filemanager=$(find /home/phablet/.cache/lomiri-app-launch/desktop -maxdepth 1 -name 'filemanager.ubports_filemanager_*.desktop' -print -quit 2>/dev/null) terminal=$(find /home/phablet/.cache/lomiri-app-launch/desktop -maxdepth 1 -name 'terminal.ubports_terminal_*.desktop' -print -quit 2>/dev/null)"
fi

# --- 1. Keep pd-mapper alive BEFORE the first ADSP boot. The container has
# mounted firmware_mnt by now. Starting it only after ADSP=running makes us
# depend on a later SSR actually dropping the remoteproc; that is racy when
# another client holds an rproc reference. With this order the audio/sensor
# PD service-registry notifications are present on the first firmware load. ---
( while true; do
    pgrep -f /vendor/bin/pd-mapper >/dev/null 2>&1 || lxc /vendor/bin/pd-mapper >/tmp/pdmapper.log 2>&1
    sleep 3
done ) >/dev/null 2>&1 &
sleep 2
echo "pd-mapper pre-boot: $(pgrep -f /vendor/bin/pd-mapper | head -1)"

# --- 2. Boot the DSPs (stock does this at early-boot) ---
c=0; while [ ! -w /sys/kernel/boot_adsp/boot ] && [ $c -lt 90 ]; do sleep 1; c=$((c+1)); done
[ -w /sys/kernel/boot_adsp/boot ] && { echo 1 > /sys/kernel/boot_adsp/boot; echo "boot_adsp"; }
[ -w /sys/kernel/boot_cdsp/boot ] && { echo 1 > /sys/kernel/boot_cdsp/boot; echo "boot_cdsp"; }
[ -w /sys/devices/virtual/cvp/cvp/boot ] && echo 1 > /sys/devices/virtual/cvp/cvp/boot
c=0; while [ "$(adsp_state)" != "running" ] && [ $c -lt 90 ]; do sleep 2; c=$((c+1)); done
echo "adsp = $(adsp_state)"

# --- 3. WLAN (validated): firmware-ready gate + /dev/wlan load trigger ---
[ -w /sys/kernel/cnss/fs_ready ] && { echo 1 > /sys/kernel/cnss/fs_ready; echo "cnss fs_ready"; sleep 6; }
c=0; while [ ! -e /dev/wlan ] && [ $c -lt 60 ]; do sleep 1; c=$((c+1)); done
if [ -e /dev/wlan ]; then
    echo "ON" > /dev/wlan; sleep 5
    ip link show wlan0 >/dev/null 2>&1 || { echo "WAIT_FOR_READY" > /dev/wlan 2>/dev/null; echo "ENABLE" > /dev/wlan 2>/dev/null; sleep 4; }
    ip link show wlan0 >/dev/null 2>&1 && echo "wlan0 up" || echo "wlan0 absent"
fi

# --- 4. pd-mapper alive; prefer the first ADSP load, SSR only as fallback. ---
if [ "$(adsp_state)" = "running" ]; then
    pgrep -f /vendor/bin/pd-mapper >/dev/null 2>&1 || { lxc /vendor/bin/pd-mapper >/tmp/pdmapper.log 2>&1 & }
    sleep 4
    echo "pd-mapper: $(pgrep -f /vendor/bin/pd-mapper | head -1)"

    # Give audio_pd from the initial boot a chance to publish APM first.
    c=0
    while ! have_card && [ $c -lt 20 ]; do sleep 2; c=$((c+1)); done
    if ! have_card && [ -w /sys/kernel/boot_adsp/ssr ]; then
        echo "ADSP SSR fallback"
        echo 1 > /sys/kernel/boot_adsp/ssr
        # wait for the audio PD to come back and the APM to answer
        c=0
        while ! have_card && [ $c -lt 40 ]; do sleep 2; c=$((c+1)); done
    fi
    echo "cards: $(cat /proc/asound/cards | tr '\n' ' ')"
    dmesg | grep -iE "apm is|audio_pd.*is up|sensor_pd.*is up" | tail -4

    # --- 5. Android audio HAL: make the late sound-card status usable. ---
    # msm_common creates these sysfs attributes only when the card registers,
    # after Android ueventd has already settled. They therefore remain 0660
    # root:root instead of root:audio (Android gid 1005). AGM, running as
    # audioserver:audio, cannot read card_state, times out, forces
    # vendor.audio.use.primary.default=true and makes audio.primary reject the
    # card. audio.hidl_compat then dereferences the failed open and crashes PA.
    # Fix ownership, respawn the HAL so AGM retries from scratch, and clear the
    # fallback property before loading the droid card.
    if have_card; then
        for n in /sys/kernel/snd_card/card_state /sys/kernel/aud_dev/state; do
            c=0; while [ ! -e "$n" ] && [ $c -lt 30 ]; do sleep 1; c=$((c+1)); done
            if [ -e "$n" ]; then
                chown 0:1005 "$n" 2>/dev/null
                chmod 0660 "$n" 2>/dev/null
                echo "audio sysfs: $(ls -ln "$n" 2>/dev/null)"
            fi
        done

        setprop vendor.audio.use.primary.default false 2>/dev/null
        old_audio_pid=$(android_pid android.hardware.audio.service_64)
        [ -n "$old_audio_pid" ] && lxc kill -9 "$old_audio_pid" 2>/dev/null
        c=0; new_audio_pid=''
        while [ $c -lt 30 ]; do
            new_audio_pid=$(android_pid android.hardware.audio.service_64)
            [ -n "$new_audio_pid" ] && [ "$new_audio_pid" != "$old_audio_pid" ] && break
            sleep 1; c=$((c+1))
        done
        sleep 5
        setprop vendor.audio.use.primary.default false 2>/dev/null
        echo "audio HAL: $old_audio_pid -> $new_audio_pid; primary.default=$(getprop vendor.audio.use.primary.default)"

        # UT PulseAudio: the HAL is now usable; clear the crash-loop and restart.
        su - phablet -c 'export XDG_RUNTIME_DIR=/run/user/32011; systemctl --user reset-failed pulseaudio.service 2>/dev/null; systemctl --user restart pulseaudio.service 2>/dev/null' 2>/dev/null
        sleep 5
        echo "PA sinks: $(su - phablet -c 'XDG_RUNTIME_DIR=/run/user/32011 pactl list short sinks 2>/dev/null' | wc -l)"
    fi
fi

# --- 6. Sensors: restart the HAL now sensor_pd is up so hybris sees sensors ---
lxc sh -c 'kill $(pidof android.hardware.sensors@2.1-service.multihal) 2>/dev/null; kill $(pidof sensors.qti) 2>/dev/null' 2>/dev/null
sleep 6
systemctl restart sensorfwd 2>/dev/null
echo "sensors: hal=$(lxc pidof android.hardware.sensors@2.1-service.multihal 2>/dev/null) sensorfwd=$(systemctl is-active sensorfwd 2>/dev/null)"

echo "== final: cards=$(grep -c '^ *[0-9]' /proc/asound/cards 2>/dev/null) wlan0=$(ip link show wlan0 >/dev/null 2>&1 && echo yes || echo no)"
chown 32011:32011 "$LOG" 2>/dev/null
sync
exit 0
