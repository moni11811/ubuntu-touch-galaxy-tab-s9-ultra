#!/bin/sh
# Boot diagnostics dump for the gts9uwifi port. Writes a full hardware
# bring-up snapshot to /var/log/ut-diag/ (persisted in userdata) so failures
# can be analyzed from TWRP even when USB/network access to the running
# system is unavailable.
D=/var/log/ut-diag
mkdir -p "$D"
ts=$(date +%Y%m%d-%H%M%S)
# keep only the last 3 dumps
ls -1dt "$D"/dump-* 2>/dev/null | tail -n +3 | xargs -r rm -rf
O="$D/dump-$ts"
mkdir -p "$O"

dump() { name=$1; shift; { echo "# $*"; "$@"; } > "$O/$name.txt" 2>&1; }

sleep 25   # let the container and HALs settle

dmesg > "$O/dmesg.txt" 2>&1
dump lsmod            lsmod
dump mounts           mount
dump vendor-modules   ls -la /vendor/lib/modules/ /android/vendor_dlkm/lib/modules/
dump firmware-mnt     ls /vendor/firmware_mnt/image/
dump net              ip link
dump rfkill           rfkill list
dump remoteproc       sh -c 'for r in /sys/class/remoteproc/remoteproc*; do echo "$r: $(cat $r/name 2>/dev/null) = $(cat $r/state 2>/dev/null)"; done'
dump sound            sh -c 'ls -la /dev/snd/ 2>/dev/null; cat /proc/asound/cards 2>/dev/null'
dump inputs           sh -c 'cat /proc/bus/input/devices'
dump usb-gadget       sh -c 'ls -la /sys/kernel/config/usb_gadget/ 2>/dev/null; cat /sys/kernel/config/usb_gadget/*/UDC 2>/dev/null; ls /sys/class/udc/ 2>/dev/null; cat /sys/devices/platform/soc/*.ssusb/mode 2>/dev/null'
dump android-services sh -c 'ps -ef | grep -E "android|vendor|hal" | grep -v grep'
dump getprop          sh -c 'command -v getprop >/dev/null && getprop || /android/system/bin/getprop'
dump logcat           sh -c 'timeout 10 /android/system/bin/logcat -d -b main -b system -b crash 2>/dev/null | tail -800'
dump efs              ls -la /mnt/vendor/efs/ /mnt/vendor/efs/wifi/ 2>/dev/null
dump journal-err      sh -c 'journalctl -b --no-pager -p err | tail -150'
sync
exit 0
