[Unit]
Description=gts9uwifi integrated bring-up (apps/DSP/WLAN/audio/sensors)
After=lxc-android-config.service ut-rootfs-writable.service
Wants=lxc-android-config.service ut-rootfs-writable.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/ut-hw-bringup
TimeoutStartSec=400
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
