#!/sbin/sh
# Ubuntu Touch installer for Samsung Galaxy Tab S9 Ultra Wi-Fi (SM-X910, gts9uwifi) ONLY.
# Writes exactly these partitions: boot, init_boot, vendor_boot, vbmeta, dtbo,
# super. dtbo gets the stock SM-X910 table back, because Halium needs the
# Samsung board overlays and a previously installed mainline port leaves that
# partition empty.
# Never touches: recovery, metadata, efs/sec_efs/persist/modemst*,
# xbl*/abl/aop/tz/hyp/devcfg/keymaster/uefisecapp/qupfw/storsec, PIT or GPT.
# It never wipes or formats userdata. After a successful flash it removes only
# the explicitly named development units/scripts previously injected into
# userdata, so the integrated image versions are used on the next boot.
# No wipes, no formats, no reboot.

OUTFD=$2
ZIPFILE="$3"

ui_print() {
    echo "ui_print $1" >> /proc/self/fd/$OUTFD
    echo "ui_print" >> /proc/self/fd/$OUTFD
}

abort() {
    ui_print "ERROR: $1"
    ui_print "Installation aborted."
    exit 1
}

cleanup_legacy_dev_overrides() {
    # /etc and /home are persistent UT userdata. Old debug units there take
    # precedence over a new system image and would invalidate an upgrade test.
    # Keep this whitelist exact: no recursive or wildcard deletion is allowed.
    SYS=/data/system-data/etc/systemd/system
    PHABLET_HOME=/data/user-data/phablet

    mount /data >/dev/null 2>&1 || true
    if [ ! -d "$SYS" ]; then
        ui_print "No persistent UT systemd tree found; no legacy cleanup needed."
        return 0
    fi

    ui_print "Removing obsolete injected development services..."
    for unit in \
        ut-hw-bringup.service \
        ut-dsp-boot.service \
        ut-usb-retry.service \
        ut-diag.service \
        ut-audio-fix.service \
        ut-wlan-diag.service \
        ut-rootfs-writable.service \
        ut-ssh-enable.service; do
        rm -f "$SYS/$unit"
        rm -f "$SYS/multi-user.target.wants/$unit"
    done

    # The image service now executes /usr/libexec directly. Removing these
    # two old launch scripts proves the next boot is not using the live patch.
    rm -f "$PHABLET_HOME/ut-hw-bringup.sh"
    rm -f "$PHABLET_HOME/ut-ssh-up.sh"

    for unit in \
        ut-hw-bringup.service \
        ut-dsp-boot.service \
        ut-usb-retry.service \
        ut-diag.service \
        ut-audio-fix.service \
        ut-wlan-diag.service \
        ut-rootfs-writable.service \
        ut-ssh-enable.service; do
        [ ! -e "$SYS/$unit" ] || return 1
        [ ! -e "$SYS/multi-user.target.wants/$unit" ] || return 1
    done
    [ ! -e "$PHABLET_HOME/ut-hw-bringup.sh" ] || return 1
    [ ! -e "$PHABLET_HOME/ut-ssh-up.sh" ] || return 1
    return 0
}

ui_print "---------------------------------------"
ui_print " Ubuntu Touch 24.04 for SM-X910"
ui_print " Samsung Galaxy Tab S9 Ultra (gts9uwifi)"
ui_print "---------------------------------------"

# --- Device assertions: this package must only ever run on SM-X910 ---
DEVICE_CODENAME="$(getprop ro.product.device)"
EM_MODEL="$(getprop ro.boot.em.model)"
BOOTLOADER="$(getprop ro.bootloader)"

ui_print "Detected ro.product.device: $DEVICE_CODENAME"
ui_print "Detected ro.boot.em.model:  $EM_MODEL"
ui_print "Detected bootloader:        $BOOTLOADER"

case "$DEVICE_CODENAME" in
    gts9u|gts9uwifi) ;;
    *) abort "This package is only for gts9u/gts9uwifi (detected '$DEVICE_CODENAME')" ;;
esac

# ro.boot.em.model comes from the Samsung bootloader cmdline, not from the
# recovery build, so it identifies the real hardware.
if [ -n "$EM_MODEL" ] && [ "$EM_MODEL" != "SM-X910" ]; then
    abort "This package is only for SM-X910 (detected '$EM_MODEL')"
fi
if [ -z "$EM_MODEL" ]; then
    case "$BOOTLOADER" in
        X910*) ui_print "em.model empty; bootloader X910* accepted" ;;
        *) abort "Cannot positively identify SM-X910 (em.model empty, bootloader '$BOOTLOADER')" ;;
    esac
fi

# --- Partition presence and size checks ---
BB=/dev/block/by-name
for part in boot init_boot vendor_boot vbmeta dtbo super; do
    [ -e "$BB/$part" ] || abort "Missing partition $BB/$part"
done

blkdev_size() { blockdev --getsize64 "$1" 2>/dev/null || echo 0; }

BOOT_SIZE=$(blkdev_size "$BB/boot")
INIT_BOOT_SIZE=$(blkdev_size "$BB/init_boot")
VENDOR_BOOT_SIZE=$(blkdev_size "$BB/vendor_boot")
DTBO_SIZE=$(blkdev_size "$BB/dtbo")
SUPER_SIZE=$(blkdev_size "$BB/super")

[ "$BOOT_SIZE" -ge 100663296 ] || abort "boot partition too small ($BOOT_SIZE < 100663296)"
[ "$INIT_BOOT_SIZE" -ge 8388608 ] || abort "init_boot partition too small ($INIT_BOOT_SIZE)"
[ "$VENDOR_BOOT_SIZE" -ge 100663296 ] || abort "vendor_boot partition too small ($VENDOR_BOOT_SIZE)"
[ "$DTBO_SIZE" -eq 16777216 ] || abort "dtbo size mismatch ($DTBO_SIZE != 16777216, not SM-X910 layout)"
[ "$SUPER_SIZE" -eq 11744051200 ] || abort "super size mismatch ($SUPER_SIZE != 11744051200, not SM-X910 layout)"

# --- Tooling ---
if ! command -v zstd >/dev/null 2>&1; then
    unzip -p "$ZIPFILE" zstd > /tmp/zstd 2>/dev/null
    chmod 755 /tmp/zstd 2>/dev/null
fi
ZSTD=$(command -v zstd || echo /tmp/zstd)
[ -x "$ZSTD" ] || abort "no zstd available"

for f in boot.img init_boot.img vendor_boot.img vbmeta.img dtbo.img super.img.zst; do
    unzip -l "$ZIPFILE" "$f" >/dev/null 2>&1 || abort "ZIP is missing $f"
done

# The dtbo we ship is the stock SM-X910 table, trimmed to its dt_table size.
# Refuse to write anything that is not a real dt_table: an empty or foreign
# dtbo is exactly the failure this write exists to repair.
unzip -p "$ZIPFILE" dtbo.img | dd bs=4 count=1 2>/dev/null | od -An -tx1 \
    | tr -d ' \n' | grep -qi '^d7b7ab1e' || abort "dtbo.img is not a dt_table image"

SLOT="$(getprop ro.boot.slot_suffix)"

ui_print "Planned writes:"
ui_print "  boot.img        -> $BB/boot$SLOT"
ui_print "  init_boot.img   -> $BB/init_boot$SLOT"
ui_print "  vendor_boot.img -> $BB/vendor_boot$SLOT"
ui_print "  vbmeta.img      -> $BB/vbmeta$SLOT"
ui_print "  dtbo.img        -> $BB/dtbo$SLOT (stock SM-X910 table)"
ui_print "  super.img.zst   -> $BB/super (decompressed)"
ui_print "No other partition will be written."

ui_print "Flashing boot..."
unzip -p "$ZIPFILE" boot.img | dd of="$BB/boot$SLOT" bs=4M || abort "failed to flash boot"
ui_print "Flashing init_boot..."
unzip -p "$ZIPFILE" init_boot.img | dd of="$BB/init_boot$SLOT" bs=4M || abort "failed to flash init_boot"
ui_print "Flashing vendor_boot..."
unzip -p "$ZIPFILE" vendor_boot.img | dd of="$BB/vendor_boot$SLOT" bs=4M || abort "failed to flash vendor_boot"
ui_print "Flashing vbmeta..."
unzip -p "$ZIPFILE" vbmeta.img | dd of="$BB/vbmeta$SLOT" bs=4M 2>/dev/null || ui_print "vbmeta flash skipped"

# Halium boots the Samsung Android kernel, which needs the stock board
# overlays. A mainline port (the Ubuntu desktop one, for instance) leaves an
# empty or noop dtbo behind, and the tablet then hangs on the Samsung splash.
# Restoring the stock table makes this package self-sufficient whatever ROM
# was installed before.
ui_print "Restoring stock dtbo..."
unzip -p "$ZIPFILE" dtbo.img | dd of="$BB/dtbo$SLOT" bs=4M || abort "failed to flash dtbo"

ui_print "Writing super (several minutes)..."
unzip -p "$ZIPFILE" super.img.zst | "$ZSTD" -d --long=27 -c | dd of="$BB/super" bs=16M || abort "failed to write super"

cleanup_legacy_dev_overrides || abort "Images flashed, but legacy development overrides could not be removed"

sync

ui_print "---------------------------------------"
ui_print " Done. This installer does not reboot."
ui_print " Save the TWRP log, then reboot"
ui_print " manually with: twrp reboot system"
ui_print "---------------------------------------"

exit 0
